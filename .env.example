# Copy this file to .env and fill in the values.
# Generate keys with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  -> DATA_ENCRYPTION_KEY
#   python -c "import secrets; print(secrets.token_hex(32))"                                   -> HMAC_SECRET_KEY

# --- Mandatory security keys (no defaults; service refuses to start without them) ---
DATA_ENCRYPTION_KEY=<generate with Fernet.generate_key()>
HMAC_SECRET_KEY=<generate with secrets.token_hex(32)>

# --- API bearer tokens ---
AGENT_API_KEY=agent-key-local-001
OPS_API_KEY=ops-key-local-001

# --- CRM connector ---
CRM_BASE_URL=http://localhost:8081
CRM_TOKEN=pravar-dev-token

# --- Custodian connector ---
CUSTODIAN_DROPS_DIR=custodian_drops

# --- Database ---
DATABASE_URL=sqlite:///./household_context.db

# --- Logging ---
LOG_LEVEL=INFO
